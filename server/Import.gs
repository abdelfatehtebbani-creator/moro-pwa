/**
 * Import.gs – one-time load of the data migrated from MORO v13 (ImportData.gs, generated by
 * migration/make_import.py and never committed). Run runSetupAndImport() once from the editor.
 * A sheet that already has data rows is skipped, so a second run never duplicates anything.
 */
function runSetupAndImport() {
  setupSheets();
  var ss = SpreadsheetApp.getActive();
  var report = [];
  Object.keys(IMPORT_DATA).forEach(function (name) {
    var rows = IMPORT_DATA[name];
    var sh = ss.getSheetByName(name);
    if (sh.getLastRow() > 1) { report.push(name + ': skipped (already has ' + (sh.getLastRow() - 1) + ' rows)'); return; }
    var CHUNK = 4000;
    for (var i = 0; i < rows.length; i += CHUNK) {
      var part = rows.slice(i, i + CHUNK);
      sh.getRange(2 + i, 1, part.length, part[0].length).setValues(part);
      SpreadsheetApp.flush();
    }
    report.push(name + ': ' + rows.length + ' rows');
  });
  report.push(verifyBalances());
  Logger.log(report.join('\n'));
  return report.join('\n');
}

/** Recomputes every balance from Movements and compares it with the Balances sheet. */
function verifyBalances() {
  var ss = SpreadsheetApp.getActive();
  var mv = ss.getSheetByName('Movements').getDataRange().getValues();
  var h = mv[0], iItem = h.indexOf('item_id'), iQty = h.indexOf('qty'), iSt = h.indexOf('status');
  var sum = {};
  for (var r = 1; r < mv.length; r++) {
    if (mv[r][iSt] === 'deleted') continue;
    sum[mv[r][iItem]] = (sum[mv[r][iItem]] || 0) + Number(mv[r][iQty] || 0);
  }
  var bal = ss.getSheetByName('Balances').getDataRange().getValues();
  var bad = [];
  for (var b = 1; b < bal.length; b++) {
    var calc = Math.round((sum[bal[b][0]] || 0) * 1e6) / 1e6;
    if (Math.abs(calc - Number(bal[b][1])) > 1e-6) bad.push(bal[b][0] + ' sheet=' + bal[b][1] + ' calc=' + calc);
  }
  return 'Balance check: ' + (bal.length - 1) + ' items, ' + bad.length + ' mismatches' + (bad.length ? '\n' + bad.join('\n') : '');
}
